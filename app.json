{
  "expo": {
    "name": "Hewa",
    "slug": "weather-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.michael.nandi.weatherapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mn.hewa",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "extra": {
      "eas": {
        "projectId": "41612fd5-bdde-4176-b664-5be82d20c3cd"
      }
    },
    "owner": "michael.nandi",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/hewa-splash.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#224496"
        }
      ],
      "expo-font",
      "expo-background-task",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hewa uses your location to show the weather where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#224496"
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "HewaWeather",
              "displayName": "Hewa",
              "description": "Current weather for your location",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "src/widgets/weather-widget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "src/widgets/weather-widget.android.tsx"
              }
            }
          ]
        }
      ],
      "expo-sharing"
    ],
    "scheme": "hewa",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/41612fd5-bdde-4176-b664-5be82d20c3cd"
    }
  }
}
